{
  "compilerOptions": {
    "outDir": "build",
    "target": "es2024",
    "module": "es2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "ESNext.Temporal"],
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": false,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "types.d.ts", "vite.config.ts", "server.ts"]
}
